---
import BaseLayout from './base-layout.astro'
import SiteHeader from '../components/site-header/site-header.astro'
import SiteFooter from '../components/site-footer/site-footer.astro'
import { type Locale, type Translation } from '../i18n/t'

interface Props {
  locale: Locale
  translation: Translation
  title: string
  canonicalPath: string
  alternatePath: string
}

const { locale, translation, title, canonicalPath, alternatePath } = Astro.props
---

<BaseLayout
  locale={locale}
  title={`${title} — Keimêlion`}
  description={translation.meta.description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  ogAlt={translation.meta.ogAlt}
>
  <SiteHeader
    locale={locale}
    translation={translation}
    canonicalPath={canonicalPath}
    alternatePath={alternatePath}
  />
  <main id="main-content" class="legal">
    <div class="legal__inner">
      <slot />
    </div>
  </main>
  <SiteFooter locale={locale} translation={translation} />
</BaseLayout>

<style>
  .legal {
    padding-block: 64px;
    min-height: 60vh;
  }

  .legal__inner {
    max-width: 768px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .legal__inner :global(h1) {
    font: 800 36px/40px var(--font-display);
    letter-spacing: -0.04em;
  }
</style>

---
import BaseLayout from './base-layout.astro'
import SiteHeader from '../components/site-header/site-header.astro'
import SiteFooter from '../components/site-footer/site-footer.astro'
import { type Locale, type Translation } from '../i18n/t'

interface Props {
  locale: Locale
  translation: Translation
  title: string
  canonicalPath: string
  alternatePath: string
}

const { locale, translation, title, canonicalPath, alternatePath } = Astro.props
---

<BaseLayout
  locale={locale}
  title={`${title} — Keimêlion`}
  description={translation.meta.description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  ogAlt={translation.meta.ogAlt}
>
  <SiteHeader locale={locale} translation={translation} />
  <main class="legal">
    <div class="legal__inner container">
      <slot />
    </div>
  </main>
  <SiteFooter translation={translation} />
</BaseLayout>

<style>
  .legal {
    padding-block: var(--space-8);
    min-height: 60vh;
  }

  .legal__inner {
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
</style>

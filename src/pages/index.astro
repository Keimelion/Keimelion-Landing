---
import BaseLayout from '../layouts/base-layout.astro'
import SiteHeader from '../components/site-header.astro'
import Hero from '../components/hero.astro'
import Moments from '../components/moments.astro'
import Shelf from '../components/shelf.astro'
import Free from '../components/free.astro'
import SiteFooter from '../components/site-footer.astro'
import { Locales, getTranslation } from '../i18n/t'

export const prerender = true

const locale = Locales.FR
const translation = getTranslation(locale)
---

<BaseLayout
  locale={locale}
  title={translation.meta.title}
  description={translation.meta.description}
  canonicalPath="/"
  alternatePath="/en/"
  ogAlt={translation.meta.ogAlt}
>
  <SiteHeader
    locale={locale}
    translation={translation}
    canonicalPath="/"
    alternatePath="/en/"
  />
  <main id="main-content">
    <Hero locale={locale} translation={translation} />
    <Moments translation={translation} />
    <Shelf translation={translation} />
    <Free translation={translation} />
  </main>
  <SiteFooter locale={locale} translation={translation} />
</BaseLayout>

---
import BaseLayout from '../layouts/base-layout.astro'
import SiteHeader from '../components/site-header/site-header.astro'
import SiteFooter from '../components/site-footer/site-footer.astro'
import { Locales, getTranslation } from '../i18n/t'

export const prerender = true

const locale = Locales.FR
const translation = getTranslation(locale)
---

<BaseLayout
  locale={locale}
  title={`404 — ${translation.meta.title}`}
  description="Page introuvable / Page not found"
  canonicalPath="/404"
  alternatePath="/en/404"
  ogAlt={translation.meta.ogAlt}
>
  <SiteHeader locale={locale} translation={translation} />
  <main class="notfound">
    <div class="notfound__inner">
      <h1 class="k-h">404</h1>
      <p>Page introuvable / Page not found</p>
      <p>
        <a href="/">{translation.legalPages.backHome}</a>
      </p>
    </div>
  </main>
  <SiteFooter translation={translation} />
</BaseLayout>

<style>
  .notfound {
    padding-block: 96px;
    text-align: center;
    min-height: 50vh;
  }

  .notfound__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
  }

  .notfound h1 {
    font-size: clamp(72px, 10vw, 128px);
    color: var(--brand);
  }
</style>

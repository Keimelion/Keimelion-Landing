---
import BaseLayout from '../../layouts/base-layout.astro'
import SiteHeader from '../../components/site-header/site-header.astro'
import Hero from '../../components/hero/hero.astro'
import Moments from '../../components/moments/moments.astro'
import Shelf from '../../components/shelf/shelf.astro'
import Free from '../../components/free/free.astro'
import SiteFooter from '../../components/site-footer/site-footer.astro'
import { Locales, getTranslation } from '../../i18n/t'

export const prerender = true

const locale = Locales.EN
const translation = getTranslation(locale)
---

<BaseLayout
  locale={locale}
  title={translation.meta.title}
  description={translation.meta.description}
  canonicalPath="/en/"
  alternatePath="/"
  ogAlt={translation.meta.ogAlt}
>
  <SiteHeader
    locale={locale}
    translation={translation}
    canonicalPath="/en/"
    alternatePath="/"
  />
  <main id="main-content">
    <Hero locale={locale} translation={translation} />
    <Moments translation={translation} />
    <Shelf translation={translation} />
    <Free translation={translation} />
  </main>
  <SiteFooter locale={locale} translation={translation} />
</BaseLayout>

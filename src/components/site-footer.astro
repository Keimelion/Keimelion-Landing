---
import Logo from './logo.astro'
import { getLocalisedHomePath, type Locale, type Translation } from '../i18n/t'
import { APP_VERSION } from '../utils/app-version'

interface Props {
  locale: Locale
  translation: Translation
}

const { locale, translation } = Astro.props
const t = translation
const homeHref = getLocalisedHomePath(locale)
const copyright = t.copyright.replace('{year}', String(new Date().getFullYear()))
---

<footer class="site-footer">
  <Logo
    label="Keimêlion"
    wordmark="keimêlion"
    href={homeHref}
    size={28}
    wordmarkSize={24}
    color="var(--ink)"
  />
  <nav class="site-footer__nav" aria-label={t.footerNav}>
    <a href={t.links.legalHref} class="k-link site-footer__link">{t.legal}</a>
    <a href={t.links.contactHref} class="k-link site-footer__link">{t.contact}</a>
  </nav>
  <span class="site-footer__meta">
    <span class="site-footer__copyright">{copyright}</span>
    <span class="site-footer__version" title={t.versionLabel}>{APP_VERSION}</span>
  </span>
</footer>

<style>
  .site-footer {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding: 32px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    view-transition-name: vt-footer;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .site-footer__link {
    font-size: 14px;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }

  .site-footer__copyright {
    font-size: 14px;
    color: var(--ink-muted);
  }

  .site-footer__version {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      justify-content: flex-start;
      gap: 20px;
      padding: 32px 24px 40px;
    }

    .site-footer__nav {
      justify-content: flex-start;
    }
  }
</style>

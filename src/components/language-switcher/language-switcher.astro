---
import { Locales, type Locale } from '../../i18n/t'

interface Props {
  currentLocale: Locale
  label: string
}

const { currentLocale, label } = Astro.props
const isFr = currentLocale === Locales.FR
---

<div class="k-lang" role="group" aria-label={label} data-active={isFr ? 'fr' : 'en'}>
  <span class="k-lang__slider" aria-hidden="true"></span>
  <a
    href="/"
    class="k-lang-btn"
    aria-current={isFr ? 'page' : undefined}
    data-target-locale="fr"
    hreflang="fr"
    lang="fr"
  >
    FR
  </a>
  <a
    href="/en/"
    class="k-lang-btn"
    aria-current={!isFr ? 'page' : undefined}
    data-target-locale="en"
    hreflang="en"
    lang="en"
  >
    EN
  </a>
</div>

<script>
  const STORAGE_KEY = 'keimelion.lang'

  function bindLanguageSwitcher(): void {
    const links = document.querySelectorAll<HTMLAnchorElement>('.k-lang-btn')
    links.forEach((link) => {
      if (link.dataset.langBound === 'true') return
      link.dataset.langBound = 'true'
      link.addEventListener('click', () => {
        const locale = link.dataset.targetLocale
        if (typeof locale !== 'string') return
        try {
          localStorage.setItem(STORAGE_KEY, locale)
        } catch (error) {
          void error
        }
      })
    })
  }

  bindLanguageSwitcher()
  document.addEventListener('astro:page-load', bindLanguageSwitcher)
</script>

<style>
  .k-lang {
    position: relative;
    display: inline-flex;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    gap: 2px;
    isolation: isolate;
  }

  .k-lang__slider {
    position: absolute;
    top: 4px;
    bottom: 4px;
    width: calc(50% - 5px);
    background: #ffffff;
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 6px -2px rgba(28, 26, 51, 0.3);
    transition: left 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 0;
    view-transition-name: k-lang-slider;
  }

  .k-lang[data-active='fr'] .k-lang__slider {
    left: 4px;
  }

  .k-lang[data-active='en'] .k-lang__slider {
    left: calc(50% + 1px);
  }

  .k-lang-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-muted);
    font: 600 13px/1 var(--font-sans);
    letter-spacing: 0.06em;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .k-lang-btn[aria-current='page'] {
    color: var(--ink);
  }

  .k-lang-btn:hover {
    color: var(--ink);
  }

  .k-lang-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .k-lang__slider {
      transition: none;
      view-transition-name: none;
    }
  }
</style>

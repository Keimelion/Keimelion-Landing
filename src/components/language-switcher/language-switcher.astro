---
import { Locales, type Locale } from '../../i18n/t'

interface Props {
  currentLocale: Locale
  label: string
}

const { currentLocale, label } = Astro.props
const isFr = currentLocale === Locales.FR
---

<div class="k-lang" role="group" aria-label={label}>
  <a
    href="/"
    class:list={['k-lang-btn', isFr && 'k-lang-on']}
    aria-current={isFr ? 'page' : undefined}
    data-target-locale="fr"
    hreflang="fr"
    lang="fr"
  >
    FR
  </a>
  <a
    href="/en/"
    class:list={['k-lang-btn', !isFr && 'k-lang-on']}
    aria-current={!isFr ? 'page' : undefined}
    data-target-locale="en"
    hreflang="en"
    lang="en"
  >
    EN
  </a>
</div>

<script>
  const STORAGE_KEY = 'keimelion.lang'

  function bindLanguageSwitcher(): void {
    const links = document.querySelectorAll<HTMLAnchorElement>('.k-lang-btn')
    links.forEach((link) => {
      if (link.dataset.langBound === 'true') return
      link.dataset.langBound = 'true'
      link.addEventListener('click', () => {
        const locale = link.dataset.targetLocale
        if (typeof locale !== 'string') return
        try {
          localStorage.setItem(STORAGE_KEY, locale)
        } catch (error) {
          void error
        }
      })
    })
  }

  bindLanguageSwitcher()
  document.addEventListener('astro:page-load', bindLanguageSwitcher)
</script>

<style>
  .k-lang {
    display: inline-flex;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    gap: 2px;
  }

  .k-lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-muted);
    font: 600 13px/1 var(--font-sans);
    letter-spacing: 0.06em;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .k-lang-btn:hover {
    color: var(--ink);
  }

  .k-lang-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .k-lang-on {
    background: #ffffff;
    color: var(--ink);
    box-shadow: 0 2px 6px -2px rgba(28, 26, 51, 0.3);
  }
</style>

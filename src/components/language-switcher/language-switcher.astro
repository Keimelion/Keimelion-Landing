---
import { Locales, type Locale } from '../../i18n/t'

interface Props {
  currentLocale: Locale
  label: string
}

const { currentLocale, label } = Astro.props
const isFr = currentLocale === Locales.FR
---

<div class="k-lang" role="group" aria-label={label}>
  <button
    type="button"
    class:list={['k-lang-btn', isFr && 'k-lang-on']}
    aria-pressed={isFr ? 'true' : 'false'}
    data-target-locale="fr"
    data-target-path="/"
  >
    FR
  </button>
  <button
    type="button"
    class:list={['k-lang-btn', !isFr && 'k-lang-on']}
    aria-pressed={!isFr ? 'true' : 'false'}
    data-target-locale="en"
    data-target-path="/en/"
  >
    EN
  </button>
</div>

<script>
  const STORAGE_KEY = 'keimelion.lang'

  function navigateTo(targetPath: string, targetLocale: string): void {
    try {
      localStorage.setItem(STORAGE_KEY, targetLocale)
    } catch (error) {
      void error
    }
    window.location.assign(targetPath)
  }

  function bindLanguageSwitcher(): void {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.k-lang-btn')
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const path = button.dataset.targetPath
        const locale = button.dataset.targetLocale
        if (typeof path !== 'string' || typeof locale !== 'string') return
        if (button.getAttribute('aria-pressed') === 'true') return
        navigateTo(path, locale)
      })
    })
  }

  bindLanguageSwitcher()
</script>

<style>
  .k-lang {
    display: inline-flex;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    gap: 2px;
  }

  .k-lang-btn {
    min-width: 44px;
    min-height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-muted);
    font: 600 13px/1 var(--font-sans);
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .k-lang-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .k-lang-on {
    background: #ffffff;
    color: var(--ink);
    box-shadow: 0 2px 6px -2px rgba(28, 26, 51, 0.3);
  }
</style>

---
import type { Translation } from '../../i18n/t'

interface Props {
  translation: Translation
}

const { translation } = Astro.props
const { moments } = translation

interface Moment {
  key: 'anniversaire' | 'mariage' | 'naissance' | 'noel' | 'cremaillere'
  background: string
  foreground: string
  shape: 'flower' | 'cloud' | 'arches' | 'sun' | 'leaf'
}

const MOMENTS: readonly Moment[] = [
  { key: 'anniversaire', background: 'var(--color-rose)', foreground: 'var(--color-framboise)', shape: 'flower' },
  { key: 'mariage', background: 'var(--color-ciel)', foreground: 'var(--color-encre)', shape: 'cloud' },
  { key: 'naissance', background: 'var(--color-lilas)', foreground: 'var(--color-encre)', shape: 'arches' },
  { key: 'noel', background: 'var(--color-moutarde)', foreground: 'var(--color-framboise)', shape: 'sun' },
  { key: 'cremaillere', background: 'var(--color-menthe)', foreground: 'var(--color-emeraude)', shape: 'leaf' },
] as const
---

<section class="moments">
  <div class="moments__inner container">
    <h2 class="moments__title">{moments.title}</h2>
    <ul class="moments__grid" role="list">
      {
        MOMENTS.map((moment) => (
          <li class="moment-card" style={`--card-bg:${moment.background};--card-fg:${moment.foreground};`}>
            <div class="moment-card__shape" aria-hidden="true">
              {moment.shape === 'flower' && (
                <svg viewBox="0 0 64 64" width="64" height="64">
                  <g fill="currentColor">
                    <circle cx="32" cy="18" r="10" />
                    <circle cx="46" cy="32" r="10" />
                    <circle cx="32" cy="46" r="10" />
                    <circle cx="18" cy="32" r="10" />
                    <circle cx="32" cy="32" r="6" />
                  </g>
                </svg>
              )}
              {moment.shape === 'cloud' && (
                <svg viewBox="0 0 72 48" width="72" height="48">
                  <path
                    fill="currentColor"
                    d="M18 32c-7 0-12-5-12-12s5-12 12-12c3 0 6 1 8 3 2-6 8-10 15-10 9 0 16 7 16 16 0 1 0 2-1 3 4 2 7 7 7 12 0 7-6 13-13 13H18z"
                  />
                </svg>
              )}
              {moment.shape === 'arches' && (
                <svg viewBox="0 0 72 48" width="72" height="48">
                  <path fill="currentColor" d="M4 44V22a14 14 0 0 1 28 0v22H4zm32 0V22a14 14 0 0 1 28 0v22H36z" />
                </svg>
              )}
              {moment.shape === 'sun' && (
                <svg viewBox="0 0 64 64" width="64" height="64">
                  <g fill="currentColor">
                    <circle cx="32" cy="32" r="12" />
                    <g stroke="currentColor" stroke-width="4" stroke-linecap="round">
                      <line x1="32" y1="6" x2="32" y2="14" />
                      <line x1="32" y1="50" x2="32" y2="58" />
                      <line x1="6" y1="32" x2="14" y2="32" />
                      <line x1="50" y1="32" x2="58" y2="32" />
                      <line x1="13" y1="13" x2="19" y2="19" />
                      <line x1="45" y1="45" x2="51" y2="51" />
                      <line x1="13" y1="51" x2="19" y2="45" />
                      <line x1="45" y1="19" x2="51" y2="13" />
                    </g>
                  </g>
                </svg>
              )}
              {moment.shape === 'leaf' && (
                <svg viewBox="0 0 48 64" width="48" height="64">
                  <path fill="currentColor" d="M24 4c14 8 20 24 16 40-4 12-16 16-20 16-4 0-16-4-20-16-4-16 2-32 16-40l4-2 4 2z" />
                </svg>
              )}
            </div>
            <h3 class="moment-card__title">{moments.items[moment.key].title}</h3>
            <p class="moment-card__caption">{moments.items[moment.key].caption}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .moments {
    background: var(--color-section-bg);
    padding-block: var(--space-8);
  }

  .moments__title {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-6);
  }

  .moments__grid {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-bottom: var(--space-3);
  }

  .moments__grid > * {
    scroll-snap-align: start;
    flex: 0 0 72%;
    max-width: 20rem;
  }

  @media (min-width: 720px) {
    .moments__grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      overflow: visible;
    }

    .moments__grid > * {
      flex: 1 1 auto;
      max-width: none;
    }
  }

  .moment-card {
    background: var(--card-bg);
    color: var(--card-fg);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    min-height: 14rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .moment-card__shape {
    color: var(--card-fg);
    opacity: 0.88;
  }

  .moment-card__title {
    font-size: var(--font-size-lg);
  }

  .moment-card__caption {
    font-size: var(--font-size-sm);
    line-height: 1.5;
    color: var(--color-encre);
  }
</style>

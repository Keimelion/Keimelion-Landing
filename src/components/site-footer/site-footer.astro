---
import Logo from '../logo/logo.astro'
import type { Translation } from '../../i18n/t'

interface Props {
  translation: Translation
}

const { translation } = Astro.props
const t = translation
---

<footer class="site-footer">
  <Logo
    label="Keimêlion"
    wordmark="keimêlion"
    size={28}
    wordmarkSize={24}
    color="var(--ink)"
  />
  <nav class="site-footer__nav" aria-label={t.footerNav}>
    <a href={t.links.legalHref} class="k-link site-footer__link">{t.legal}</a>
    <a href={t.links.contactHref} class="k-link site-footer__link">{t.contact}</a>
  </nav>
  <span class="site-footer__copyright">{t.copyright}</span>
</footer>

<style>
  .site-footer {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .site-footer__link {
    font-size: 14px;
  }

  .site-footer__copyright {
    font-size: 14px;
    color: var(--ink-muted);
  }
</style>

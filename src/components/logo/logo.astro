---
/*
 * Brand mark + wordmark. The infinity-ribbon SVG is the design-system brand
 * mark (identical geometry to the mockup, lines 136 and following). Colour is
 * driven by the `color` prop so the mark can be re-tinted on dark surfaces.
 */
interface Props {
  label: string
  wordmark: string
  size?: number
  wordmarkSize?: number
  color?: string
}

const { label, wordmark, size = 40, wordmarkSize = 32, color = 'var(--brand)' } = Astro.props
---

<a href="/" class="logo" aria-label={label}>
  <svg
    class="logo__mark"
    viewBox="0 0 100 100"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
  >
    <g transform="translate(0 -2)" fill={color} stroke={color}>
      <path
        stroke="none"
        d="M46 50C40 62 32 74 22 86l8-1 3 8c8-12 14-26 17-40zM54 50c6 12 14 24 24 36l-8-1-3 8c-8-12-14-26-17-40z"
      ></path>
      <path
        d="M50 44C42 26 14 24 14 42c0 16 24 18 36 2 12-16 36-18 36-2 0 18-28 16-36 0z"
        fill="none"
        stroke-width="11"
        stroke-linejoin="round"
      ></path>
      <circle stroke="none" cx="50" cy="46" r="7"></circle>
    </g>
  </svg>
  <span class="logo__wordmark" style={`font-size:${wordmarkSize}px;color:${color}`}>
    {wordmark}
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--brand);
  }

  .logo__mark {
    flex: none;
  }

  .logo__wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
  }
</style>

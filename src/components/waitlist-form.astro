---
import type { Locale, Translation } from '../i18n/t'
import StatusBadge from './status-badge.astro'

interface Props {
  locale: Locale
  translation: Translation
}

const { locale, translation } = Astro.props
const t = translation
---

<form
  class="k-form"
  method="POST"
  action="/api/waitlist"
  novalidate
  data-locale={locale}
  data-i18n-error={t.form.error}
  data-i18n-invalid-email={t.form.errorInvalidEmail}
  data-i18n-rate-limited={t.form.errorRateLimited}
  data-i18n-submit={t.notify}
  data-i18n-submitting={t.form.submitting}
>
  <div class="k-form__fields" data-waitlist-fields>
    <label for="k-email" class="k-form__label">
      {t.formLabel}
    </label>
    <div class="k-form__row">
      <input
        id="k-email"
        name="email"
        class="k-input"
        type="email"
        required
        autocomplete="email"
        inputmode="email"
        placeholder={t.placeholder}
        aria-describedby="k-email-error"
      />
      <button type="submit" class="k-btn k-btn-primary k-form__submit">
        {t.notify}
      </button>
    </div>
    <div
      class="k-form__error"
      id="k-email-error"
      role="alert"
      tabindex="-1"
      data-waitlist-error
      hidden
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7.5v5"></path>
        <path d="M12 16h.01"></path>
      </svg>
      <p data-waitlist-error-text></p>
    </div>
    <div class="visually-hidden k-form__hp" aria-hidden="true">
      <label>
        <span>{t.form.honeypotLabel}</span>
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="consent" value="true" />
    <span class="k-form__privacy">
      {t.privacy}&nbsp;
      <a href={t.form.privacyHref} class="k-form__privacy-link">
        {t.form.privacyLink}
      </a>
      .
    </span>
  </div>
  <div
    class="k-form__sent"
    role="status"
    aria-live="polite"
    tabindex="-1"
    data-waitlist-sent
    data-i18n-body={t.waitlist.form.success.body}
    hidden
  >
    <StatusBadge icon="mail" tone="cream" />
    <div class="k-form__sent-text">
      <p class="k-form__sent-title">{t.waitlist.form.success.title}</p>
      <p data-waitlist-sent-body></p>
      <p class="k-form__sent-hint">{t.waitlist.form.success.hint}</p>
    </div>
  </div>
</form>

<script>
  interface SuccessPayload {
    ok: true
  }

  interface FailurePayload {
    ok: false
    error: 'invalid_email' | 'invalid_consent' | 'rate_limited' | 'invalid_payload'
  }

  type ResponsePayload = SuccessPayload | FailurePayload

  function isResponsePayload(value: unknown): value is ResponsePayload {
    if (typeof value !== 'object' || value === null) return false
    const record = value as Record<string, unknown>
    return typeof record.ok === 'boolean'
  }

  function errorMessageFor(form: HTMLFormElement, code: FailurePayload['error']): string {
    const map: Record<FailurePayload['error'], string | undefined> = {
      invalid_email: form.dataset.i18nInvalidEmail,
      invalid_consent: form.dataset.i18nError,
      rate_limited: form.dataset.i18nRateLimited,
      invalid_payload: form.dataset.i18nError,
    }
    return map[code] ?? form.dataset.i18nError ?? ''
  }

  const EMAIL_PLACEHOLDER = '{email}'

  // The address is inserted as a text node, never as HTML.
  function fillSentBody(node: HTMLElement, template: string, email: string): void {
    const [before = '', after = ''] = template.split(EMAIL_PLACEHOLDER)
    const strong = document.createElement('strong')
    strong.textContent = email
    node.replaceChildren(before, strong, after)
  }

  function showCheckInbox(form: HTMLFormElement, email: string): void {
    const fields = form.querySelector<HTMLElement>('[data-waitlist-fields]')
    const sent = form.querySelector<HTMLElement>('[data-waitlist-sent]')
    const body = form.querySelector<HTMLElement>('[data-waitlist-sent-body]')
    if (fields === null || sent === null || body === null) return
    fillSentBody(body, sent.dataset.i18nBody ?? '', email)
    fields.hidden = true
    sent.hidden = false
    sent.focus()
  }

  function emailInput(form: HTMLFormElement): HTMLInputElement | null {
    return form.querySelector<HTMLInputElement>('input[name="email"]')
  }

  function showError(form: HTMLFormElement, message: string, code?: FailurePayload['error']): void {
    const node = form.querySelector<HTMLElement>('[data-waitlist-error]')
    const text = form.querySelector<HTMLElement>('[data-waitlist-error-text]')
    if (node === null || text === null) return
    text.textContent = message
    node.hidden = message.length === 0
    const input = emailInput(form)
    const isInvalidEmail = code === 'invalid_email'
    input?.toggleAttribute('aria-invalid', isInvalidEmail)
    if (message.length === 0) return
    if (isInvalidEmail) {
      input?.focus()
      return
    }
    node.focus()
  }

  function setSubmitting(form: HTMLFormElement, isSubmitting: boolean): void {
    const button = form.querySelector<HTMLButtonElement>('.k-form__submit')
    if (button === null) return
    const label = isSubmitting ? form.dataset.i18nSubmitting : form.dataset.i18nSubmit
    button.disabled = isSubmitting
    if (typeof label === 'string') button.textContent = label
  }

  async function submit(form: HTMLFormElement): Promise<void> {
    const data = new FormData(form)
    const payload = {
      email: String(data.get('email') ?? ''),
      locale: String(data.get('locale') ?? 'fr'),
      consent: data.get('consent') === 'true',
      website: String(data.get('website') ?? ''),
    }
    showError(form, '')
    setSubmitting(form, true)
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      })
      const raw: unknown = await response.json()
      if (!isResponsePayload(raw)) {
        showError(form, form.dataset.i18nError ?? '')
        return
      }
      if (raw.ok) {
        showCheckInbox(form, payload.email.trim().toLowerCase())
        form.reset()
        return
      }
      showError(form, errorMessageFor(form, raw.error), raw.error)
    } catch (error) {
      void error
      showError(form, form.dataset.i18nError ?? '')
    } finally {
      setSubmitting(form, false)
    }
  }

  function bindWaitlistForms(): void {
    document.querySelectorAll<HTMLFormElement>('form.k-form').forEach((form) => {
      if (form.dataset.waitlistBound === 'true') return
      form.dataset.waitlistBound = 'true'
      form.addEventListener('submit', (event) => {
        event.preventDefault()
        void submit(form)
      })
      // The error stays until the visitor edits the address, then clears with the red outline
      emailInput(form)?.addEventListener('input', () => {
        const error = form.querySelector<HTMLElement>('[data-waitlist-error]')
        if (error?.hidden === false) showError(form, '')
      })
    })
  }

  bindWaitlistForms()
  document.addEventListener('astro:page-load', bindWaitlistForms)
</script>

<style>
  .k-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 520px;
  }

  .k-form__label {
    font-size: 14px;
    font-weight: 600;
  }

  .k-form__row {
    display: flex;
    align-items: stretch;
    gap: 0;
    padding: 0;
    background: #ffffff;
    border: 1.5px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    max-width: 520px;
    box-sizing: border-box;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .k-form__row:focus-within {
    border-color: var(--ink);
  }

  .k-form__row:has(.k-input[aria-invalid]) {
    border-color: var(--danger);
    box-shadow: 0 0 0 3px rgba(163, 38, 26, 0.16);
  }

  .k-form__row .k-input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 54px;
    padding: 0 22px;
    border: 0;
    background: transparent;
    border-radius: 0;
  }

  .k-form__row .k-input:focus-visible {
    outline: none;
  }

  .k-form__submit {
    flex: 0 0 auto;
    align-self: stretch;
    min-height: 54px;
    padding: 0 26px;
    font-size: 15px;
    border-radius: var(--radius-pill);
  }

  .k-form__submit[disabled] {
    opacity: 0.75;
    cursor: progress;
  }

  @media (max-width: 420px) {
    .k-form__row {
      flex-wrap: wrap;
      border-radius: 24px;
      overflow: visible;
    }

    .k-form__row .k-input {
      flex: 1 1 100%;
      min-height: 48px;
    }

    .k-form__submit {
      flex: 1 1 100%;
      min-height: 48px;
      margin-top: 4px;
    }
  }

  .k-form__privacy {
    font-size: 13px;
    line-height: 18px;
    color: var(--ink-muted);
  }

  .k-form__privacy-link {
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .k-form__privacy-link:hover,
  .k-form__privacy-link:focus-visible {
    color: var(--brand);
  }

  .k-form__fields {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .k-form__fields[hidden],
  .k-form__sent[hidden] {
    display: none;
  }

  /* KEI-164 "check your inbox": icon, title, body and hint stacked on the mint card */
  .k-form__sent {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 520px;
    padding: 20px;
    border-radius: 22px;
    background: var(--paper-mint);
    color: var(--ink);
    animation: k-form-sent-reveal 0.35s ease-out;
  }

  .k-form__sent:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .k-form__sent-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .k-form__sent-text p {
    margin: 0;
    font-size: 15px;
    line-height: 22px;
  }

  .k-form__sent-text .k-form__sent-title {
    font: 800 24px/28px var(--font-display);
    letter-spacing: -0.03em;
  }

  .k-form__sent-text .k-form__sent-hint {
    font-size: 13px;
    line-height: 18px;
  }

  @keyframes k-form-sent-reveal {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .k-form__sent {
      animation: none;
    }
  }

  /* Not in the KEI-164 handoff: built from its tokens (danger ink on a rose-tinted card) */
  .k-form__error {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 520px;
    padding: 12px 16px;
    border-radius: 14px;
    background: #fbe4e0;
    box-shadow: inset 0 0 0 1.5px var(--danger);
    color: var(--danger);
    animation: k-form-sent-reveal 0.2s ease-out;
  }

  .k-form__error svg {
    flex: none;
    margin-top: 1px;
  }

  .k-form__error p {
    margin: 0;
    font-size: 15px;
    line-height: 22px;
    font-weight: 600;
  }

  .k-form__error[hidden] {
    display: none;
  }

  .k-form__error:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .k-form__error {
      animation: none;
    }
  }
</style>

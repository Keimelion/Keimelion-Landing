---
import WaitlistForm from '../waitlist-form/waitlist-form.astro'
import type { Locale, Translation } from '../../i18n/t'

interface Props {
  locale: Locale
  translation: Translation
}

const { locale, translation } = Astro.props
const { hero } = translation
---

<section class="hero">
  <div class="hero__inner container">
    <div class="hero__content">
      <span class="hero__badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        {hero.badge}
      </span>
      <p class="hero__handwritten">{hero.handwritten}</p>
      <h1 class="hero__title">{hero.title}</h1>
      <p class="hero__lede">{hero.lede}</p>
      <WaitlistForm locale={locale} translation={translation} />
      <p class="hero__name-explanation">{hero.nameExplanation}</p>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__arch"></div>
      <div class="hero__list-card">
        <p class="hero__list-label">{hero.listDemoLabel}</p>
        <div class="hero__gift">
          <div class="hero__gift-box"></div>
          <div class="hero__gift-ribbon-h"></div>
          <div class="hero__gift-ribbon-v"></div>
          <div class="hero__gift-bow"></div>
        </div>
      </div>
      <div class="hero__pile">
        <span class="hero__pile-gift hero__pile-gift--one"></span>
        <span class="hero__pile-gift hero__pile-gift--two"></span>
        <span class="hero__pile-gift hero__pile-gift--three"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    padding: var(--space-2) var(--space-4);
    background: rgb(179 32 76 / 10%);
    color: var(--color-accent-deep);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__badge-dot {
      animation: hero-pulse 1800ms ease-in-out infinite;
    }
  }

  @keyframes hero-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.4);
      opacity: 0.55;
    }
  }

  .hero__handwritten {
    font-family: var(--font-accent);
    color: var(--color-accent);
    font-size: var(--font-size-xl);
    line-height: 1;
    transform: rotate(-3deg);
    align-self: flex-start;
    margin-bottom: calc(var(--space-2) * -1);
  }

  .hero__title {
    font-size: var(--font-size-4xl);
    color: var(--color-fg);
  }

  .hero__lede {
    color: var(--color-fg-muted);
    font-size: var(--font-size-md);
    max-width: 36rem;
  }

  .hero__name-explanation {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-fg-muted);
    max-width: 36rem;
  }

  .hero__visual {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 28rem;
    margin-inline: auto;
    width: 100%;
  }

  .hero__arch {
    position: absolute;
    inset: 10% 10% 10% 10%;
    background: var(--color-lilas);
    border-radius: 100% 100% var(--radius-xl) var(--radius-xl) / 60% 60% 10% 10%;
    z-index: 0;
  }

  .hero__list-card {
    position: absolute;
    inset: 30% 15% auto 15%;
    bottom: 20%;
    background: #fff;
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-lg);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
    justify-content: center;
    min-height: 10rem;
  }

  .hero__list-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  .hero__gift {
    position: relative;
    width: 5rem;
    height: 5rem;
  }

  .hero__gift-box {
    position: absolute;
    inset: 0;
    background: var(--color-moutarde);
    border-radius: var(--radius-sm);
  }

  .hero__gift-ribbon-h,
  .hero__gift-ribbon-v {
    position: absolute;
    background: var(--color-framboise);
  }

  .hero__gift-ribbon-h {
    inset: 48% 0;
    height: 10%;
  }

  .hero__gift-ribbon-v {
    inset: 0 48%;
    width: 10%;
  }

  .hero__gift-bow {
    position: absolute;
    top: -12%;
    left: 50%;
    width: 36%;
    height: 24%;
    transform: translateX(-50%);
    background: radial-gradient(circle at 25% 50%, var(--color-framboise) 48%, transparent 50%),
      radial-gradient(circle at 75% 50%, var(--color-framboise) 48%, transparent 50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__gift {
      animation: gift-wrap 7500ms cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }

    .hero__gift-bow {
      animation: bow-pop 7500ms cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }
  }

  @keyframes gift-wrap {
    0%,
    15% {
      transform: scale(0.86) rotate(-3deg);
    }
    40%,
    60% {
      transform: scale(1) rotate(0deg);
    }
    85%,
    100% {
      transform: scale(0.86) rotate(3deg);
    }
  }

  @keyframes bow-pop {
    0%,
    35% {
      opacity: 0;
      transform: translateX(-50%) scale(0.4);
    }
    55%,
    80% {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: translateX(-50%) scale(0.4);
    }
  }

  .hero__pile {
    position: absolute;
    bottom: 6%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--space-2);
    z-index: 1;
  }

  .hero__pile-gift {
    width: 2.5rem;
    height: 2rem;
    border-radius: var(--radius-sm);
  }

  .hero__pile-gift--one {
    background: var(--color-rose);
  }

  .hero__pile-gift--two {
    background: var(--color-ciel);
  }

  .hero__pile-gift--three {
    background: var(--color-menthe);
  }
</style>

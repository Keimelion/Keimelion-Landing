---
import type { Translation } from '../../i18n/t'

interface Props {
  translation: Translation
}

const { translation } = Astro.props
const { list } = translation
---

<section class="list-section">
  <div class="list-section__inner container">
    <div class="list-section__text">
      <h2 class="list-section__title">{list.title}</h2>
      <p class="list-section__caption">{list.caption}</p>
    </div>
    <div class="list-section__visual" aria-hidden="true">
      <div class="list-section__card">
        <div class="list-section__row"></div>
        <div class="list-section__row list-section__row--short"></div>
        <div class="list-section__gift">
          <div class="list-section__gift-box"></div>
          <div class="list-section__gift-ribbon list-section__gift-ribbon--h"></div>
          <div class="list-section__gift-ribbon list-section__gift-ribbon--v"></div>
          <div class="list-section__gift-bow"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .list-section {
    padding-block: var(--space-8);
    background: var(--color-bg);
  }

  .list-section__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 820px) {
    .list-section__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .list-section__title {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-3);
  }

  .list-section__caption {
    color: var(--color-fg-muted);
    font-size: var(--font-size-md);
    max-width: 28rem;
  }

  .list-section__visual {
    display: flex;
    justify-content: center;
  }

  .list-section__card {
    position: relative;
    width: min(22rem, 100%);
    aspect-ratio: 4 / 5;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    overflow: hidden;
  }

  .list-section__row {
    height: 0.75rem;
    background: var(--color-sable);
    border-radius: var(--radius-pill);
    width: 70%;
  }

  .list-section__row--short {
    width: 40%;
  }

  .list-section__gift {
    position: absolute;
    inset: auto 50% 20% 50%;
    width: 7rem;
    height: 7rem;
    transform: translateX(-50%);
  }

  .list-section__gift-box {
    position: absolute;
    inset: 0;
    background: var(--color-vermillon);
    border-radius: var(--radius-md);
  }

  .list-section__gift-ribbon {
    position: absolute;
    background: var(--color-moutarde);
  }

  .list-section__gift-ribbon--h {
    inset: 48% 0;
    height: 10%;
  }

  .list-section__gift-ribbon--v {
    inset: 0 48%;
    width: 10%;
  }

  .list-section__gift-bow {
    position: absolute;
    top: -14%;
    left: 50%;
    width: 50%;
    height: 28%;
    transform: translateX(-50%);
    background: radial-gradient(circle at 25% 50%, var(--color-moutarde) 48%, transparent 50%),
      radial-gradient(circle at 75% 50%, var(--color-moutarde) 48%, transparent 50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .list-section__gift {
      animation: list-wrap 8000ms cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }

    .list-section__gift-bow {
      animation: list-bow 8000ms cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }
  }

  @keyframes list-wrap {
    0%,
    15% {
      transform: translateX(-50%) scale(0.8) rotate(-2deg);
    }
    45%,
    60% {
      transform: translateX(-50%) scale(1) rotate(0deg);
    }
    85%,
    100% {
      transform: translateX(-50%) scale(0.8) rotate(2deg);
    }
  }

  @keyframes list-bow {
    0%,
    30% {
      opacity: 0;
      transform: translateX(-50%) scale(0.4);
    }
    55%,
    75% {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: translateX(-50%) scale(0.4);
    }
  }
</style>

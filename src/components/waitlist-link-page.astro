---
import BaseLayout from '../layouts/base-layout.astro'
import SiteHeader from './site-header.astro'
import SiteFooter from './site-footer.astro'
import { getLocalisedHomePath, getTranslation, type Locale } from '../i18n/t'

export type WaitlistLinkMode = 'confirm' | 'unsubscribe'

interface Props {
  locale: Locale
  mode: WaitlistLinkMode
  canonicalPath: string
  alternatePath: string
}

const ENDPOINTS: Record<WaitlistLinkMode, string> = {
  confirm: '/api/waitlist/confirm',
  unsubscribe: '/api/waitlist/unsubscribe',
}

// The form's email field: "back to the form" lands on it
const FORM_ANCHOR = '#k-email'

const { locale, mode, canonicalPath, alternatePath } = Astro.props
const translation = getTranslation(locale)
const copy = translation.waitlist
const homeHref = getLocalisedHomePath(locale)
const metaTitle = mode === 'confirm' ? copy.confirm.metaTitle : copy.unsubscribe.metaTitle
const loadingLabel = mode === 'confirm' ? copy.confirm.loading : copy.unsubscribe.loading
const errorLabel = mode === 'confirm' ? copy.confirm.error : copy.unsubscribe.error
---

<BaseLayout
  locale={locale}
  title={metaTitle}
  description={translation.meta.description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  ogAlt={translation.meta.ogAlt}
>
  <Fragment slot="head">
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <SiteHeader
    locale={locale}
    translation={translation}
    canonicalPath={canonicalPath}
    alternatePath={alternatePath}
  />
  <main id="main-content" class="k-wl-page">
    <section
      class="k-wl-page__column"
      aria-live="polite"
      data-waitlist-link
      data-mode={mode}
      data-endpoint={ENDPOINTS[mode]}
    >
      <div class="k-wl-page__panel k-wl-page__panel--loading" data-panel="loading" role="status">
        <span class="k-wl-page__pulse" aria-hidden="true">
          <svg width="52" height="52">
            <use href="#brand-ribbon"></use>
          </svg>
        </span>
        <p class="k-wl-page__loading">{loadingLabel}</p>
      </div>

      {mode === 'confirm' && (
        <>
          <div class="k-wl-page__panel" data-panel="confirmed" hidden>
            <svg
              class="k-wl-page__gift"
              aria-hidden="true"
              viewBox="0 0 120 110"
              width="120"
              height="110"
            >
              <defs>
                <pattern id="k-wl-gift-dots" width="14" height="14" patternUnits="userSpaceOnUse">
                  <rect width="14" height="14" fill="#cdb8f5"></rect>
                  <circle cx="4" cy="4" r="2.6" fill="#fffaf0"></circle>
                  <circle cx="11" cy="11" r="2.6" fill="#fffaf0"></circle>
                </pattern>
              </defs>
              <rect x="14" y="30" width="92" height="74" rx="10" fill="url(#k-wl-gift-dots)"></rect>
              <rect x="52" y="30" width="16" height="74" fill="#fffaf0"></rect>
              <rect x="14" y="58" width="92" height="14" fill="#fffaf0"></rect>
              <use href="#brand-ribbon" x="29" y="1.5" width="62" height="62"></use>
            </svg>
            <span class="k-wl-page__kicker">{copy.confirm.success.kicker}</span>
            <h1 class="k-wl-page__title k-wl-page__title--hero" tabindex="-1">
              {copy.confirm.success.title}
            </h1>
            <p class="k-wl-page__body">{copy.confirm.success.body}</p>
            <a class="k-btn k-wl-page__cta k-wl-page__cta--secondary" href={homeHref}>
              {copy.confirm.success.cta}
            </a>
          </div>
          <div class="k-wl-page__panel" data-panel="invalid" hidden>
            <span class="k-wl-page__icon k-wl-page__icon--rose" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="34"
                height="34"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="13" r="8"></circle>
                <path d="M12 9v4l2.5 2.5"></path>
                <path d="M9 2h6"></path>
              </svg>
            </span>
            <h1 class="k-wl-page__title" tabindex="-1">
              {copy.confirm.invalid.title}
            </h1>
            <p class="k-wl-page__body">{copy.confirm.invalid.body}</p>
            <a class="k-btn k-btn-primary k-wl-page__cta" href={`${homeHref}${FORM_ANCHOR}`}>
              {copy.confirm.invalid.cta}
            </a>
          </div>
        </>
      )}

      {mode === 'unsubscribe' && (
        <div class="k-wl-page__panel" data-panel="done" hidden>
          <span class="k-wl-page__icon k-wl-page__icon--mint" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="34"
              height="34"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m5 12.5 4.5 4.5L19 7.5"></path>
            </svg>
          </span>
          <h1 class="k-wl-page__title" tabindex="-1">
            {copy.unsubscribe.done.title}
          </h1>
          <p class="k-wl-page__body">{copy.unsubscribe.done.body}</p>
          <p class="k-wl-page__note">{copy.unsubscribe.done.again}</p>
          <a class="k-btn k-wl-page__cta k-wl-page__cta--secondary" href={homeHref}>
            {copy.unsubscribe.done.cta}
          </a>
        </div>
      )}

      <div class="k-wl-page__panel" data-panel="error" hidden>
        <span class="k-wl-page__icon k-wl-page__icon--rose" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="34"
            height="34"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3.5 2.8 19.5h18.4z"></path>
            <path d="M12 10v4"></path>
            <path d="M12 17h.01"></path>
          </svg>
        </span>
        <p class="k-wl-page__body k-wl-page__body--strong" role="alert" tabindex="-1">
          {errorLabel}
        </p>
        <button type="button" class="k-btn k-btn-primary k-wl-page__cta" data-waitlist-retry>
          {copy.retry}
        </button>
      </div>
    </section>
  </main>
  <SiteFooter locale={locale} translation={translation} />
</BaseLayout>

<script>
  type Outcome = 'success' | 'invalid' | 'error'

  const TOKEN_FRAGMENT_KEY = 'token'
  const HTTP_BAD_REQUEST = 400

  // The token travels in the URL fragment so that it never reaches a server access log.
  function readToken(): string | null {
    return new URLSearchParams(location.hash.slice(1)).get(TOKEN_FRAGMENT_KEY)
  }

  function forgetToken(): void {
    history.replaceState(history.state, '', `${location.pathname}${location.search}`)
  }

  async function postToken(endpoint: string, token: string): Promise<Outcome> {
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ token }),
      })
      if (response.ok) return 'success'
      return response.status === HTTP_BAD_REQUEST ? 'invalid' : 'error'
    } catch {
      return 'error'
    }
  }

  // Deleting always ends on "deleted", whether the address existed or not.
  function panelFor(mode: string | undefined, outcome: Outcome): string {
    if (outcome === 'error') return 'error'
    if (mode === 'unsubscribe') return 'done'
    return outcome === 'success' ? 'confirmed' : 'invalid'
  }

  function showPanel(root: HTMLElement, name: string): void {
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
      panel.hidden = panel.dataset.panel !== name
    })
    root.querySelector<HTMLElement>(`[data-panel="${name}"] [tabindex="-1"]`)?.focus()
  }

  // On an error the token stays in the URL, so trying again replays the same request.
  async function resolveLink(root: HTMLElement): Promise<void> {
    showPanel(root, 'loading')
    const token = readToken()
    const outcome = token === null ? 'invalid' : await postToken(root.dataset.endpoint ?? '', token)
    if (outcome !== 'error') forgetToken()
    showPanel(root, panelFor(root.dataset.mode, outcome))
  }

  function bindWaitlistLinks(): void {
    document.querySelectorAll<HTMLElement>('[data-waitlist-link]').forEach((root) => {
      if (root.dataset.waitlistBound === 'true') return
      root.dataset.waitlistBound = 'true'
      root.querySelector('[data-waitlist-retry]')?.addEventListener('click', () => {
        void resolveLink(root)
      })
      void resolveLink(root)
    })
  }

  bindWaitlistLinks()
  document.addEventListener('astro:page-load', bindWaitlistLinks)
</script>

<style>
  /* KEI-164 "landing states": a 480px column on the page background, vertically centred. */
  .k-wl-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 62vh;
    padding: 48px 24px 64px;
  }

  .k-wl-page__column {
    width: 100%;
    max-width: 480px;
  }

  .k-wl-page__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .k-wl-page__panel[hidden] {
    display: none;
  }

  .k-wl-page__panel--loading {
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .k-wl-page__pulse {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--brand);
    animation: k-wl-pulse 1.4s ease-in-out infinite;
  }

  .k-wl-page__loading {
    margin: 0;
    font: 600 17px/24px var(--font-sans);
  }

  .k-wl-page__gift {
    align-self: center;
    color: var(--brand);
  }

  .k-wl-page__kicker {
    font: 600 30px/30px var(--font-hand);
    color: var(--brand);
    transform: rotate(-3deg);
    transform-origin: left center;
  }

  .k-wl-page__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-pill);
    color: var(--ink);
  }

  .k-wl-page__icon--rose {
    background: var(--paper-rose);
  }

  .k-wl-page__icon--mint {
    background: var(--paper-mint);
    color: #13694d;
  }

  .k-wl-page__title {
    margin: 0;
    font: 800 30px/1.05 var(--font-display);
    letter-spacing: -0.04em;
  }

  .k-wl-page__title--hero {
    font-size: 34px;
    line-height: 1;
  }

  .k-wl-page__title:focus,
  .k-wl-page__body:focus {
    outline: none;
  }

  .k-wl-page__body {
    margin: 0;
    font: var(--text-body);
    color: var(--ink-muted);
  }

  .k-wl-page__body--strong {
    color: var(--ink);
    font-weight: 500;
  }

  .k-wl-page__note {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }

  .k-wl-page__cta {
    min-height: 48px;
  }

  .k-wl-page__cta--secondary {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--rule-strong);
  }

  .k-wl-page__cta--secondary:hover {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  @keyframes k-wl-pulse {
    50% {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .k-wl-page__pulse {
      animation: none;
    }
  }

  @media (max-width: 420px) {
    .k-wl-page {
      padding: 32px 24px 48px;
    }
  }
</style>

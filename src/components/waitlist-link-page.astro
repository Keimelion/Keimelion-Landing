---
import BaseLayout from '../layouts/base-layout.astro'
import SiteHeader from './site-header.astro'
import SiteFooter from './site-footer.astro'
import { getLocalisedHomePath, getTranslation, type Locale } from '../i18n/t'

export type WaitlistLinkMode = 'confirm' | 'unsubscribe'

interface Props {
  locale: Locale
  mode: WaitlistLinkMode
  canonicalPath: string
  alternatePath: string
}

const ENDPOINTS: Record<WaitlistLinkMode, string> = {
  confirm: '/api/waitlist/confirm',
  unsubscribe: '/api/waitlist/unsubscribe',
}

const { locale, mode, canonicalPath, alternatePath } = Astro.props
const translation = getTranslation(locale)
const copy = translation.waitlist
const homeHref = getLocalisedHomePath(locale)
const metaTitle = mode === 'confirm' ? copy.confirm.metaTitle : copy.unsubscribe.metaTitle
const loadingLabel = mode === 'confirm' ? copy.confirm.loading : copy.unsubscribe.loading
const errorLabel = mode === 'confirm' ? copy.confirm.error : copy.unsubscribe.error
---

<BaseLayout
  locale={locale}
  title={metaTitle}
  description={translation.meta.description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  ogAlt={translation.meta.ogAlt}
>
  <Fragment slot="head">
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <SiteHeader
    locale={locale}
    translation={translation}
    canonicalPath={canonicalPath}
    alternatePath={alternatePath}
  />
  <main id="main-content" class="k-link">
    <section
      class="k-link__card"
      aria-live="polite"
      data-waitlist-link
      data-mode={mode}
      data-endpoint={ENDPOINTS[mode]}
    >
      <div class="k-link__panel" data-panel="loading">
        <svg class="k-link__ribbon" aria-hidden="true" width="56" height="56">
          <use href="#brand-ribbon"></use>
        </svg>
        <p class="k-link__loading">{loadingLabel}</p>
      </div>

      {mode === 'confirm' && (
        <>
          <div class="k-link__panel" data-panel="confirmed" hidden>
            <span class="k-link__kicker">{copy.confirm.success.kicker}</span>
            <h1 tabindex="-1">{copy.confirm.success.title}</h1>
            <p>{copy.confirm.success.body}</p>
            <a class="k-btn k-btn-primary k-link__cta" href={homeHref}>
              {copy.confirm.success.cta}
            </a>
          </div>
          <div class="k-link__panel" data-panel="invalid" hidden>
            <h1 tabindex="-1">{copy.confirm.invalid.title}</h1>
            <p>{copy.confirm.invalid.body}</p>
            <a class="k-btn k-btn-primary k-link__cta" href={homeHref}>
              {copy.confirm.invalid.cta}
            </a>
          </div>
        </>
      )}

      {mode === 'unsubscribe' && (
        <div class="k-link__panel" data-panel="done" hidden>
          <h1 tabindex="-1">{copy.unsubscribe.done.title}</h1>
          <p>{copy.unsubscribe.done.body}</p>
          <p class="k-link__muted">{copy.unsubscribe.done.again}</p>
          <a class="k-btn k-btn-primary k-link__cta" href={homeHref}>
            {copy.unsubscribe.done.cta}
          </a>
        </div>
      )}

      <div class="k-link__panel" data-panel="error" hidden>
        <p class="k-link__error" tabindex="-1">
          {errorLabel}
        </p>
      </div>
    </section>
  </main>
  <SiteFooter locale={locale} translation={translation} />
</BaseLayout>

<script>
  type Outcome = 'success' | 'invalid' | 'error'

  const TOKEN_FRAGMENT_KEY = 'token'
  const HTTP_BAD_REQUEST = 400

  // The token travels in the URL fragment so that it never reaches a server access log.
  function readToken(): string | null {
    return new URLSearchParams(location.hash.slice(1)).get(TOKEN_FRAGMENT_KEY)
  }

  function forgetToken(): void {
    history.replaceState(history.state, '', `${location.pathname}${location.search}`)
  }

  async function postToken(endpoint: string, token: string): Promise<Outcome> {
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ token }),
      })
      if (response.ok) return 'success'
      return response.status === HTTP_BAD_REQUEST ? 'invalid' : 'error'
    } catch {
      return 'error'
    }
  }

  // Deleting always ends on "deleted", whether the address existed or not.
  function panelFor(mode: string | undefined, outcome: Outcome): string {
    if (outcome === 'error') return 'error'
    if (mode === 'unsubscribe') return 'done'
    return outcome === 'success' ? 'confirmed' : 'invalid'
  }

  function showPanel(root: HTMLElement, name: string): void {
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
      panel.hidden = panel.dataset.panel !== name
    })
    root.querySelector<HTMLElement>(`[data-panel="${name}"] [tabindex="-1"]`)?.focus()
  }

  async function resolveLink(root: HTMLElement): Promise<void> {
    const token = readToken()
    const outcome = token === null ? 'invalid' : await postToken(root.dataset.endpoint ?? '', token)
    if (outcome !== 'error') forgetToken()
    showPanel(root, panelFor(root.dataset.mode, outcome))
  }

  function bindWaitlistLinks(): void {
    document.querySelectorAll<HTMLElement>('[data-waitlist-link]').forEach((root) => {
      if (root.dataset.waitlistBound === 'true') return
      root.dataset.waitlistBound = 'true'
      void resolveLink(root)
    })
  }

  bindWaitlistLinks()
  document.addEventListener('astro:page-load', bindWaitlistLinks)
</script>

<style>
  .k-link {
    padding: 64px 24px;
    min-height: 60vh;
  }

  .k-link__card {
    max-width: 480px;
    margin: 0 auto;
    padding: 40px 32px;
    border-radius: 22px;
    background: var(--surface-raised);
    box-shadow: var(--shadow-tile);
  }

  .k-link__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .k-link__panel[hidden] {
    display: none;
  }

  .k-link__panel[data-panel='loading'] {
    align-items: center;
    text-align: center;
  }

  .k-link__panel h1 {
    margin: 0;
    font: 800 32px/1.1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .k-link__panel h1:focus,
  .k-link__error:focus {
    outline: none;
  }

  .k-link__panel p {
    margin: 0;
    font: var(--text-body);
  }

  .k-link__kicker {
    font: 600 28px/28px var(--font-hand);
    color: var(--brand);
  }

  .k-link__muted {
    color: var(--ink-muted);
  }

  .k-link__error {
    color: var(--danger);
    font-weight: 500;
  }

  .k-link__ribbon {
    color: var(--brand);
    animation: k-link-pulse 1.2s ease-in-out infinite;
  }

  @keyframes k-link-pulse {
    50% {
      transform: scale(1.12);
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .k-link__ribbon {
      animation: none;
    }
  }

  @media (max-width: 420px) {
    .k-link {
      padding: 40px 16px;
    }

    .k-link__card {
      padding: 32px 20px;
    }
  }
</style>

---
import Logo from '../logo/logo.astro'
import LanguageSwitcher from '../language-switcher/language-switcher.astro'
import type { Locale, Translation } from '../../i18n/t'

interface Props {
  locale: Locale
  translation: Translation
}

const { locale, translation } = Astro.props
---

<header class="k-head">
  <Logo label="Keimêlion" wordmark="keimêlion" />
  <LanguageSwitcher currentLocale={locale} label={translation.langLabel} />
</header>

<style>
  .k-head {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  @media (max-width: 720px) {
    .k-head {
      flex-wrap: nowrap;
      padding: 16px;
      gap: 8px;
    }

    .k-head :global(.logo__wordmark) {
      font-size: 24px !important;
    }

    .k-head :global(.logo__mark) {
      width: 30px;
      height: 30px;
    }
  }
</style>

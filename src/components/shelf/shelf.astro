---
import type { Translation } from '../../i18n/t'

interface Props {
  translation: Translation
}

const { translation } = Astro.props
const t = translation
---

<section class="shelf" aria-labelledby="k-shelf-t">
  <div class="shelf__left">
    <div class="shelf__card">
      <div class="shelf__couple">
        <span class="k-hand shelf__couple-hand">{t.weddingOf}</span>
        <span class="k-h k-couple">Léa &amp; Axel</span>
      </div>

      <div class="shelf__scene">
        <div class="k-shelf">
          <div class="k-parcel k-parcel--p1" aria-hidden="true">
            <svg viewBox="0 0 100 100" width="28" height="28" class="k-parcel__bow">
              <g transform="translate(0 -2)">
                <path
                  fill="#f2bf3d"
                  d="M46 50C40 62 32 74 22 86l8-1 3 8c8-12 14-26 17-40zM54 50c6 12 14 24 24 36l-8-1-3 8c-8-12-14-26-17-40z"
                ></path>
                <path
                  d="M50 44C42 26 14 24 14 42c0 16 24 18 36 2 12-16 36-18 36-2 0 18-28 16-36 0z"
                  fill="none"
                  stroke="#f2bf3d"
                  stroke-width="11"
                  stroke-linejoin="round"
                ></path>
                <circle cx="50" cy="46" r="7" fill="#f2bf3d"></circle>
              </g>
            </svg>
          </div>
          <div class="k-parcel k-parcel--p2" aria-hidden="true">
            <svg viewBox="0 0 100 100" width="28" height="28" class="k-parcel__bow">
              <g transform="translate(0 -2)">
                <path
                  fill="#b3204c"
                  d="M46 50C40 62 32 74 22 86l8-1 3 8c8-12 14-26 17-40zM54 50c6 12 14 24 24 36l-8-1-3 8c-8-12-14-26-17-40z"
                ></path>
                <path
                  d="M50 44C42 26 14 24 14 42c0 16 24 18 36 2 12-16 36-18 36-2 0 18-28 16-36 0z"
                  fill="none"
                  stroke="#b3204c"
                  stroke-width="11"
                  stroke-linejoin="round"
                ></path>
                <circle cx="50" cy="46" r="7" fill="#b3204c"></circle>
              </g>
            </svg>
          </div>
          <div class="k-parcel k-parcel--p3" aria-hidden="true">
            <svg viewBox="0 0 100 100" width="28" height="28" class="k-parcel__bow">
              <g transform="translate(0 -2)">
                <path
                  fill="#b3204c"
                  d="M46 50C40 62 32 74 22 86l8-1 3 8c8-12 14-26 17-40zM54 50c6 12 14 24 24 36l-8-1-3 8c-8-12-14-26-17-40z"
                ></path>
                <path
                  d="M50 44C42 26 14 24 14 42c0 16 24 18 36 2 12-16 36-18 36-2 0 18-28 16-36 0z"
                  fill="none"
                  stroke="#b3204c"
                  stroke-width="11"
                  stroke-linejoin="round"
                ></path>
                <circle cx="50" cy="46" r="7" fill="#b3204c"></circle>
              </g>
            </svg>
          </div>
          <div class="k-parcel k-parcel--p4" aria-hidden="true">
            <svg viewBox="0 0 100 100" width="28" height="28" class="k-parcel__bow">
              <g transform="translate(0 -2)">
                <path
                  fill="#f2bf3d"
                  d="M46 50C40 62 32 74 22 86l8-1 3 8c8-12 14-26 17-40zM54 50c6 12 14 24 24 36l-8-1-3 8c-8-12-14-26-17-40z"
                ></path>
                <path
                  d="M50 44C42 26 14 24 14 42c0 16 24 18 36 2 12-16 36-18 36-2 0 18-28 16-36 0z"
                  fill="none"
                  stroke="#f2bf3d"
                  stroke-width="11"
                  stroke-linejoin="round"
                ></path>
                <circle cx="50" cy="46" r="7" fill="#f2bf3d"></circle>
              </g>
            </svg>
          </div>

          <!-- Falling parcels landing on empty slots -->
          <div class="k-slot-wrap k-slot-wrap--s1" aria-hidden="true">
            <div class="k-slot"></div>
            <div class="k-parcel k-a-fall k-parcel--s1">
              <svg viewBox="0 0 100 100" width="26" height="26" class="k-parcel__bow">
                <g transform="translate(0 -2)">
                  <path
                    fill="#b3204c"
                    d="M46 50C40 62 32 74 22 86l8-1 3 8c8-12 14-26 17-40zM54 50c6 12 14 24 24 36l-8-1-3 8c-8-12-14-26-17-40z"
                  ></path>
                  <path
                    d="M50 44C42 26 14 24 14 42c0 16 24 18 36 2 12-16 36-18 36-2 0 18-28 16-36 0z"
                    fill="none"
                    stroke="#b3204c"
                    stroke-width="11"
                    stroke-linejoin="round"
                  ></path>
                  <circle cx="50" cy="46" r="7" fill="#b3204c"></circle>
                </g>
              </svg>
            </div>
          </div>
          <div class="k-slot-wrap k-slot-wrap--s2" aria-hidden="true">
            <div class="k-slot"></div>
            <div class="k-parcel k-a-fall k-parcel--s2">
              <svg viewBox="0 0 100 100" width="26" height="26" class="k-parcel__bow">
                <g transform="translate(0 -2)">
                  <path
                    fill="#b3204c"
                    d="M46 50C40 62 32 74 22 86l8-1 3 8c8-12 14-26 17-40zM54 50c6 12 14 24 24 36l-8-1-3 8c-8-12-14-26-17-40z"
                  ></path>
                  <path
                    d="M50 44C42 26 14 24 14 42c0 16 24 18 36 2 12-16 36-18 36-2 0 18-28 16-36 0z"
                    fill="none"
                    stroke="#b3204c"
                    stroke-width="11"
                    stroke-linejoin="round"
                  ></path>
                  <circle cx="50" cy="46" r="7" fill="#b3204c"></circle>
                </g>
              </svg>
            </div>
          </div>
          <div class="k-slot-wrap k-slot-wrap--s3" aria-hidden="true">
            <div class="k-slot"></div>
            <div class="k-parcel k-a-fall k-parcel--s3">
              <svg viewBox="0 0 100 100" width="26" height="26" class="k-parcel__bow">
                <g transform="translate(0 -2)">
                  <path
                    fill="#b3204c"
                    d="M46 50C40 62 32 74 22 86l8-1 3 8c8-12 14-26 17-40zM54 50c6 12 14 24 24 36l-8-1-3 8c-8-12-14-26-17-40z"
                  ></path>
                  <path
                    d="M50 44C42 26 14 24 14 42c0 16 24 18 36 2 12-16 36-18 36-2 0 18-28 16-36 0z"
                    fill="none"
                    stroke="#b3204c"
                    stroke-width="11"
                    stroke-linejoin="round"
                  ></path>
                  <circle cx="50" cy="46" r="7" fill="#b3204c"></circle>
                </g>
              </svg>
            </div>
          </div>
        </div>
        <div class="shelf__board"></div>
      </div>

      <div class="shelf__counter-row">
        <span class="shelf__counter-label">
          <span class="shelf__counter" aria-hidden="true">
            <span class="k-c4">4</span>
            <span class="k-c5">5</span>
            <span class="k-c6">6</span>
            <span class="k-c7">7</span>
          </span>
          <span>{t.reservedOf}</span>
          <span class="k-hand k-a-plus" aria-hidden="true">+1 !</span>
        </span>
        <span class="k-label">{t.example}</span>
      </div>
    </div>
  </div>

  <div class="shelf__right">
    <h2 id="k-shelf-t" class="shelf__title">
      <span class="k-hand shelf__hand">{t.shelfHand}</span>
      <span class="k-h k-h2">{t.shelfTitle}</span>
    </h2>
    <p class="shelf__text">{t.shelfText}</p>
  </div>
</section>

<style>
  .shelf {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding-block: clamp(56px, 8vw, 96px);
    padding-inline: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }

  .shelf__left {
    flex: 1 1 460px;
    min-width: 0;
  }

  .shelf__card {
    position: relative;
    border-radius: 28px;
    background: var(--paper-lilac);
    padding: 32px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    /* Lets the "Léa & Axel" display face size against the card width,
       not the viewport — the card is squeezed in the 2-column desktop
       layout at 1024–1120 while the viewport is still comfortable. */
    container-type: inline-size;
  }

  .shelf__couple {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .shelf__couple-hand {
    font-size: clamp(26px, 3.4vw, 34px);
    line-height: 1;
    color: var(--ink);
  }

  .k-couple {
    /* Sized against the lilac card's inline-size via cqi so the heading
       never clips past the card's rounded corner even when it's squeezed
       by the two-column desktop layout. */
    font-size: clamp(36px, 11cqi, 68px);
    line-height: 0.95;
    overflow-wrap: break-word;
  }

  .shelf__scene {
    display: flex;
    flex-direction: column;
    gap: 0;
    /* Container query root: the parcels row scales down proportionally as the
       scene narrows (tablet, two-column desktop at 1024–1120, mobile). Without
       this the row wraps to a second line between 1024 and ~1150 px. */
    container-type: inline-size;
    /* The scaled row keeps its full ~478 px layout width while visually
       shrinking via --shelf-scale; clip that layout bleed here so it never
       pokes past the lilac card. */
    overflow: hidden;
  }

  .k-shelf {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    /* Natural width is ~478 px (parcels + slots + gaps + padding). Any shrink
       below that happens through --shelf-scale rather than a wrap. */
    flex-wrap: nowrap;
    justify-content: flex-start;
    min-height: 96px;
    padding: 0 12px;
    transform-origin: left bottom;
    transform: scale(var(--shelf-scale, 1));
  }

  /* Scale the row down in bands so it fits inside the lilac card at every
     breakpoint. Breakpoints are the available scene inner width, not the
     viewport, which keeps the two-column desktop and mobile paths consistent. */
  @container (max-width: 478px) {
    .k-shelf { --shelf-scale: 0.9; }
  }
  @container (max-width: 430px) {
    .k-shelf { --shelf-scale: 0.8; }
  }
  @container (max-width: 383px) {
    .k-shelf { --shelf-scale: 0.72; }
  }
  @container (max-width: 345px) {
    .k-shelf { --shelf-scale: 0.65; }
  }
  @container (max-width: 310px) {
    .k-shelf { --shelf-scale: 0.58; }
  }
  @container (max-width: 280px) {
    .k-shelf { --shelf-scale: 0.52; }
  }

  .k-parcel--p1 {
    width: 64px;
    height: 52px;
    background: #b3204c;
  }

  .k-parcel--p2 {
    width: 46px;
    height: 76px;
    background: #f2bf3d;
    transform: rotate(-4deg);
  }

  .k-parcel--p3 {
    width: 56px;
    height: 40px;
    background: #9fcbf2;
    transform: rotate(3deg);
  }

  .k-parcel--p4 {
    width: 72px;
    height: 62px;
    background: #13694d;
  }

  .k-parcel__bow {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: -16px 0 0 -14px;
    z-index: 1;
  }

  .k-slot-wrap {
    position: relative;
    flex: none;
  }

  .k-slot-wrap--s1 {
    width: 52px;
    height: 52px;
  }

  .k-slot-wrap--s2 {
    width: 44px;
    height: 64px;
  }

  .k-slot-wrap--s3 {
    width: 60px;
    height: 44px;
  }

  .k-slot-wrap .k-slot {
    position: absolute;
    inset: 0;
  }

  .k-slot-wrap .k-parcel {
    position: absolute;
    inset: 0;
  }

  .k-parcel--s1 {
    background: #f7b8c8;
  }

  .k-parcel--s2 {
    background: #f2bf3d;
  }

  .k-parcel--s3 {
    background: #f2622e;
  }

  .k-parcel--s1 .k-parcel__bow,
  .k-parcel--s2 .k-parcel__bow,
  .k-parcel--s3 .k-parcel__bow {
    margin: -15px 0 0 -13px;
  }

  .shelf__board {
    height: 8px;
    border-radius: 4px;
    background: var(--ink);
    opacity: 0.85;
  }

  .shelf__counter-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .shelf__counter-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
  }

  .shelf__counter {
    display: inline-grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    box-sizing: border-box;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--ink);
    font-weight: 700;
    overflow: hidden;
  }

  .shelf__counter > span {
    grid-area: 1 / 1;
  }

  .k-c4,
  .k-c5,
  .k-c6,
  .k-c7 {
    display: inline-block;
  }

  .k-c5,
  .k-c6,
  .k-c7 {
    opacity: 0;
  }

  .k-a-plus {
    display: inline-block;
    margin-left: 6px;
    font-size: 24px;
    color: var(--brand);
    opacity: 0;
    visibility: hidden;
  }

  .shelf__right {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .shelf__title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .shelf__hand {
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.1;
  }

  .shelf__text {
    margin: 0;
    max-width: 460px;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.6;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  /* Timeline (8s cycle):
       t1 — gift 1 lands at 15% (1.20s), counter 4 → 5, +1 pulses
       t2 — gift 2 lands at 30% (2.40s), counter 5 → 6, +1 pulses
       t3 — gift 3 lands at 45% (3.60s), counter 6 → 7, +1 pulses
       45-88% — all three sit on the shelf, counter stays on 7
       93-100% — fade out, reset */
  @keyframes kFall1 {
    0% {
      opacity: 0;
      transform: translateY(-300px) rotate(-28deg);
    }
    3% {
      opacity: 1;
    }
    13% {
      transform: translateY(0) rotate(6deg) scale(1);
    }
    14% {
      transform: translateY(0) scale(1.16, 0.8);
    }
    15% {
      transform: translateY(-14px) rotate(-3deg);
    }
    16%,
    88% {
      opacity: 1;
      transform: translateY(0) rotate(0) scale(1);
    }
    93%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }
  @keyframes kFall2 {
    0%,
    15% {
      opacity: 0;
      transform: translateY(-300px) rotate(-28deg);
    }
    18% {
      opacity: 1;
    }
    28% {
      transform: translateY(0) rotate(5deg) scale(1);
    }
    29% {
      transform: translateY(0) scale(1.16, 0.8);
    }
    30% {
      transform: translateY(-14px) rotate(-3deg);
    }
    31%,
    88% {
      opacity: 1;
      transform: translateY(0) rotate(0) scale(1);
    }
    93%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }
  @keyframes kFall3 {
    0%,
    30% {
      opacity: 0;
      transform: translateY(-300px) rotate(-28deg);
    }
    33% {
      opacity: 1;
    }
    43% {
      transform: translateY(0) rotate(6deg) scale(1);
    }
    44% {
      transform: translateY(0) scale(1.16, 0.8);
    }
    45% {
      transform: translateY(-14px) rotate(-3deg);
    }
    46%,
    88% {
      opacity: 1;
      transform: translateY(0) rotate(0) scale(1);
    }
    93%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }
  @keyframes kC4 {
    0%,
    14% {
      opacity: 1;
      transform: translateY(0);
    }
    16%,
    94% {
      opacity: 0;
      transform: translateY(-10px);
    }
    98%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes kC5 {
    0%,
    14% {
      opacity: 0;
      transform: translateY(10px);
    }
    16%,
    29% {
      opacity: 1;
      transform: translateY(0);
    }
    31%,
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }
  @keyframes kC6 {
    0%,
    29% {
      opacity: 0;
      transform: translateY(10px);
    }
    31%,
    44% {
      opacity: 1;
      transform: translateY(0);
    }
    46%,
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }
  @keyframes kC7 {
    0%,
    44% {
      opacity: 0;
      transform: translateY(10px);
    }
    46%,
    88% {
      opacity: 1;
      transform: translateY(0);
    }
    93%,
    100% {
      opacity: 0;
    }
  }
  @keyframes kPlus {
    0%,
    14% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
    }
    15%,
    20% {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    22%,
    29% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
    }
    30%,
    35% {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    37%,
    44% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
    }
    45%,
    52% {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    54%,
    100% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .k-parcel--s1 {
      animation: kFall1 8s cubic-bezier(0.34, 1.56, 0.64, 1) infinite both;
    }
    .k-parcel--s2 {
      animation: kFall2 8s cubic-bezier(0.34, 1.56, 0.64, 1) infinite both;
    }
    .k-parcel--s3 {
      animation: kFall3 8s cubic-bezier(0.34, 1.56, 0.64, 1) infinite both;
    }
    .k-c4 {
      animation: kC4 8s ease infinite;
    }
    .k-c5 {
      animation: kC5 8s ease infinite;
    }
    .k-c6 {
      animation: kC6 8s ease infinite;
    }
    .k-c7 {
      animation: kC7 8s ease infinite;
    }
    .k-a-plus {
      animation: kPlus 8s ease infinite;
    }
  }

  @media (max-width: 720px) {
    .shelf {
      gap: 32px;
    }
  }
</style>

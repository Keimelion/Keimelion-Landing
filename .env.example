# Base URL of the Keimelion API — only its public endpoints are consumed by this landing.
# Prefixed PUBLIC_* so Astro embeds it in the client bundle (no secret value expected here).
PUBLIC_API_BASE_URL=http://localhost:3000

# Server-only API URL used by /api/waitlist, read at runtime. In production it must stay on the
# internal network: a public URL goes through Caddy, which replaces the forwarded visitor IP.
API_INTERNAL_URL=http://localhost:3000
